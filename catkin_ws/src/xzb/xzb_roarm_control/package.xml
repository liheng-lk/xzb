<?xml version="1.0"?>
<package format="2">
  <name>xzb_roarm_control</name>
  <version>0.2.0</version>
  <description>Safety-gated ROS1 control and kinematics for XZB RoArm-M2-S.</description>
  <maintainer email="liheng-lk@users.noreply.github.com">liheng-lk</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>xzb_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>xzb_description</exec_depend>
  <exec_depend>xzb_roarm_driver</exec_depend>
  <export/>
</package>
