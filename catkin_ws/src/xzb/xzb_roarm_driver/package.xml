<?xml version="1.0"?>
<package format="2">
  <name>xzb_roarm_driver</name>
  <version>0.2.0</version>
  <description>ROS1 Noetic serial/protocol driver for Waveshare RoArm-M2-S.</description>
  <maintainer email="liheng-lk@users.noreply.github.com">liheng-lk</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>xzb_interfaces</depend>
  <exec_depend>python3-serial</exec_depend>
  <export/>
</package>
